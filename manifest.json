{
  "manifest_version": 3,
  "name": "Gemini 桌宠观察窗 (Gemini Pet Observer)",
  "version": "2.1.1",
  "description": "全网页冲浪 AI 桌宠与 Gemini 无感额度监控：支持视频页 3s/10s/20s 三帧连拍识图、普通页实时截屏识图（阅后即焚零落盘）、自定义冷却、切走取消、性格×行为人设、随机心情、双向好感度投喂与独立对话窗。",
  "icons": {
    "48": "icon.png",
    "128": "icon.png"
  },
  "permissions": [
    "storage",
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "https://gemini.google.com/*",
    "https://*/*",
    "http://127.0.0.1/*",
    "http://localhost/*",
    "http://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "allow_usage_iframe",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "*.webp",
        "*.png"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}