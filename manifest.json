{
  "manifest_version": 3,
  "name": "Gemini 桌宠观察窗 (Gemini Pet Observer)",
  "version": "2.0.0",
  "description": "全网页冲浪 AI 桌宠与 Gemini 无感额度监控：支持任意网页智能围观（10秒全局节流）、性格×行为双维人设、随机心情、正负双向好感度与投喂道具、独立大模型聊天窗及自由拖动缩放。",
  "icons": {
    "48": "icon.png",
    "128": "icon.png"
  },
  "permissions": ["storage", "declarativeNetRequest"],
  "host_permissions": [
    "https://gemini.google.com/*",
    "https://*/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "allow_usage_iframe",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["*.webp", "*.png"],
      "matches": ["<all_urls>"]
    }
  ]
}
